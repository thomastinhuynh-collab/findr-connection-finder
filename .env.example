# findr — variables d'environnement
#
# Copier ce fichier en `.env` et remplir les valeurs.
# Le `.env` est ignoré par Git (cf. .gitignore).
#
# Les valeurs ci-dessous sont publiques par nature :
# - VITE_SUPABASE_URL : URL publique du projet Supabase
# - VITE_SUPABASE_PROJECT_ID : ID du projet Supabase
# - VITE_SUPABASE_PUBLISHABLE_KEY : clé "anon" publique (JWT role=anon),
#     conçue pour être exposée côté client. La sécurité repose sur les
#     Row Level Security policies définies dans supabase/migrations/.
#
# ⚠️ NE JAMAIS METTRE ICI :
# - service_role key Supabase (clé admin, JWT role=service_role)
# - mots de passe ou secrets backend
# Ces secrets vont dans `.env` (ignoré par Git) ou dans le secret manager
# du serveur cible.

VITE_SUPABASE_PROJECT_ID="kfnggqhawjvzgajakbgd"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtmbmdncWhhd2p2emdhamFrYmdkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjgzOTYwODksImV4cCI6MjA4Mzk3MjA4OX0.zOo2Hee8uV4FobAsUzGc2ODkGuNdbHAJ6pGAWXtc8Go"
